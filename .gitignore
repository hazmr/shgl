# ==========================================================
# shgl — project-wide .gitignore (client + server)
# ==========================================================

# ---------- IDEs / Editors ----------
.idea/
**/.idea/
*.iml
*.ipr
*.iws
.vscode/
.fleet/
.project
.classpath
.settings/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- OS ----------
.Trash-*
ehthumbs.db
Desktop.ini

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Env / secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ==========================================================
# Server (Java / Spring Boot / Maven)
# ==========================================================
target/
**/target/
!**/src/**/target/
build/
out/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.ctxt
.mtj.tmp/

# Maven wrapper cache
.mvn/wrapper/maven-wrapper.jar

# Spring Boot
*.original
HELP.md

# JVM crash logs
hs_err_pid*
replay_pid*

# ==========================================================
# Client (Node / Vite / React)
# ==========================================================
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
.vite/
.cache/
.parcel-cache/
coverage/
.nyc_output/
.eslintcache
.stylelintcache
.turbo/
.next/
.nuxt/
.svelte-kit/
next-env.d.ts
**/next-env.d.ts
*.tsbuildinfo
.vercel/
**/.vercel/
**/.next/

# Package manager artifacts
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Local history / temp
.tmp/
tmp/
*.tmp
*.bak
*.orig

*.vscode

# ---------- CI / GitHub ----------
.github/
